# Copia este archivo como .env.local y completa con los datos de Supabase
# (Project Settings → API). Ambos valores son públicos por diseño; la seguridad
# la dan los permisos de supabase/esquema.sql. NUNCA pongas aquí la "secret key" ni la clave de la base.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
